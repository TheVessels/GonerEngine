[sub_resource type="GDScript" id="GDScript_n2hw7"]
script/source = "extends StaticBody2D

func interact() -> void:
	var text = [
		\"* T{wait(30)}oI'm the [shake rate=50.0 level=10 connected=1][color=red][img=x32]res://sprites/example/tennatime.png[/img] Roaring Knight[/color][/shake]!\",
		\"* wait{wait(10)} what the fuck\",
		\"Where is my{wait(5)} aste{wait(50)}rick\",
		\"* ive got many askerisks?\\n* yes\\n* maybe too many\",
		\"* funnytext test\\n* [img=350x70]res://sprites/souls/soul.png[/img]\"
	]
	TextBox.start_dialogue(text)
	Util.explode(self, Vector2(2, 0.5), 0.5)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_j46a3"]

[sub_resource type="GDScript" id="GDScript_oqv75"]
script/source = "extends Area2D

func _on_body_entered(body: Node2D) -> void:
	var text = [
		\"* a{penis}a $#!&-stains\",
		\"* $#!&-stains on the wall\",
		\"yo\"
	]
	TextBox.start_dialogue(text)
"

[sub_resource type="GDScript" id="GDScript_s20un"]
script/source = "extends StaticBody2D

func interact() -> void:
	BattleController.spawn()

func _process(_delta: float) -> void:
	if Global.in_battle:
		$Sprite2D.rotation = PI
	else:
		$Sprite2D.rotation = 0
"

